{
  "manifest_version": 3,
  "name": "Bili Theme Sync",
  "version": "1.0.0",
  "description": "让哔哩哔哩原生深浅色主题跟随系统，保留临时手动切换。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["https://*.bilibili.com/*"],
    "js": ["theme.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }]
}
